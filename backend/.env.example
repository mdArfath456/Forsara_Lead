NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/forsara-leads
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-a-long-random-secret

# Admin login is NOT read from this file. After npm install, run:
#   node src/scripts/seedAdmin.js <username> <password>
# This creates/updates the one admin account in MongoDB (AdminUser collection).

# Primary discovery source — Places API (New). Required for search to work.
# https://console.cloud.google.com -> enable "Places API (New)" -> Credentials
GOOGLE_PLACES_API_KEY=

# Fallback discovery source (used if Google Places fails or hits a rate limit)
# https://location.foursquare.com -> Developer Console -> free tier, no card
FOURSQUARE_API_KEY=
# API-key authentication only. Do NOT create OAuth credentials for this server-to-server app.
# Create the key in Apollo Settings -> Integrations -> API Keys.
# For development you may use a master key; use a scoped key in production.
APOLLO_API_KEY=
EXPLORIUM_API_KEY=

CORS_ORIGIN=http://localhost:5173
